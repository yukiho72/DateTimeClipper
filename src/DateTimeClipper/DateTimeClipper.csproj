<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DateTimeClipper</RootNamespace>
    <AssemblyName>DateTimeClipper</AssemblyName>
    <!-- マルチモニタでメニュー/ポップアップが正しいモニタに出るようPerMonitorV2を宣言 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 本アプリは実体がWPFで、DPI認識はWPFのためにmanifestで宣言する必要がある。
         WinFormsアナライザーのWFO0003(manifestでなくWinForms APIで設定せよ)は当てはまらないため抑制 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- NotifyIconのためにWinForms参照は必要だが、implicit usingsの
         System.Windows.Forms はWPFの型名と衝突するため外す -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
