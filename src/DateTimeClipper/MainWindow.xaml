<Window x:Class="DateTimeClipper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DateTimeClipper.Controls"
        Title="DateTimeClipper"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Width="300" Height="130" MinWidth="100" MinHeight="60"
        MouseEnter="OnMouseEnterWindow" MouseLeave="OnMouseLeaveWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="HoverButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder" CornerRadius="8" PreviewMouseLeftButtonDown="OnBorderMouseDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="設定(_S)" Click="OnSettingsClick"/>
                <MenuItem Header="非表示(_H)" Click="OnHideClick"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="OnExitClick"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AnalogColumn" Width="*"/>
                <ColumnDefinition x:Name="DigitalColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <ctrl:AnalogClock x:Name="Analog" Grid.Column="0" Margin="0,0,4,0"/>
            <StackPanel x:Name="DigitalPanel" Grid.Column="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DateText" TextAlignment="Center"/>
                <TextBlock x:Name="TimeText" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="HoverButtons" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-4,-4,0" Opacity="0" Grid.ColumnSpan="2">
                <Button Content="&#x2699;" Style="{StaticResource HoverButton}"
                        Click="OnSettingsClick" ToolTip="設定"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
