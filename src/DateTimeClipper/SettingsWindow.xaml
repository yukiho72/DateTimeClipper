<Window x:Class="DateTimeClipper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - DateTimeClipper"
        Width="540" Height="600" MinWidth="440" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="Manual">
    <TabControl Margin="8">

        <TabItem Header="時計">
            <StackPanel Margin="12">
                <GroupBox Header="表示モード" Padding="8">
                    <StackPanel>
                        <RadioButton x:Name="ModeBoth" Content="アナログ＋デジタル（横並び）" Margin="0,2" Checked="OnModeChecked"/>
                        <RadioButton x:Name="ModeAnalog" Content="アナログのみ" Margin="0,2" Checked="OnModeChecked"/>
                        <RadioButton x:Name="ModeDigital" Content="デジタルのみ" Margin="0,2" Checked="OnModeChecked"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="デジタル表示フォーマット" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="日付行（空欄にすると非表示）"/>
                        <TextBox x:Name="DateFormatBox" Margin="0,2,0,8" TextChanged="OnDateFormatChanged"/>
                        <TextBlock Text="時刻行（空欄にすると非表示）"/>
                        <TextBox x:Name="TimeFormatBox" Margin="0,2,0,4" TextChanged="OnTimeFormatChanged"/>
                        <TextBlock x:Name="DigitalPreview" Foreground="Gray" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
                <CheckBox x:Name="SecondsCheck" Content="アナログ時計の秒針を表示" Margin="0,12,0,0"
                          Checked="OnSecondsChanged" Unchecked="OnSecondsChanged"/>
                <CheckBox x:Name="TopmostCheck" Content="常に最前面に表示" Margin="0,8,0,0"
                          Checked="OnTopmostChanged" Unchecked="OnTopmostChanged"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="外観">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <GroupBox Header="テーマプリセット" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ダーク" Margin="0,0,6,0" Padding="10,4" Click="OnPresetDark"/>
                            <Button Content="ライト" Margin="0,0,6,0" Padding="10,4" Click="OnPresetLight"/>
                            <Button Content="半透明ダーク" Margin="0,0,6,0" Padding="10,4" Click="OnPresetTranslucent"/>
                            <Button Content="完全透明" Padding="10,4" Click="OnPresetTransparent"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="フォント" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <ComboBox x:Name="FontBox" SelectionChanged="OnFontChanged"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="文字サイズ" Width="90"/>
                                <TextBlock x:Name="SizeLabel" DockPanel.Dock="Right" Width="36" TextAlignment="Right"/>
                                <Slider x:Name="SizeSlider" Minimum="8" Maximum="72" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="OnSizeChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="色と不透明度" Padding="8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="文字色" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextColorBox" Grid.Row="0" Grid.Column="1" Margin="0,2" TextChanged="OnColorChanged"/>
                            <Border x:Name="TextColorPreview" Grid.Row="0" Grid.Column="2" Width="18" Height="18"
                                    BorderBrush="Gray" BorderThickness="1" Margin="4,0"/>
                            <Slider x:Name="TextOpacitySlider" Grid.Row="0" Grid.Column="3" Minimum="0" Maximum="1"
                                    LargeChange="0.1" ValueChanged="OnOpacityChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TextOpacityLabel" Grid.Row="0" Grid.Column="4" TextAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="時計色" VerticalAlignment="Center"/>
                            <TextBox x:Name="ClockColorBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="OnColorChanged"/>
                            <Border x:Name="ClockColorPreview" Grid.Row="1" Grid.Column="2" Width="18" Height="18"
                                    BorderBrush="Gray" BorderThickness="1" Margin="4,0"/>
                            <Slider x:Name="ClockOpacitySlider" Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="1"
                                    LargeChange="0.1" ValueChanged="OnOpacityChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClockOpacityLabel" Grid.Row="1" Grid.Column="4" TextAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="背景色" VerticalAlignment="Center"/>
                            <TextBox x:Name="BgColorBox" Grid.Row="2" Grid.Column="1" Margin="0,2" TextChanged="OnColorChanged"/>
                            <Border x:Name="BgColorPreview" Grid.Row="2" Grid.Column="2" Width="18" Height="18"
                                    BorderBrush="Gray" BorderThickness="1" Margin="4,0"/>
                            <Slider x:Name="BgOpacitySlider" Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="1"
                                    LargeChange="0.1" ValueChanged="OnOpacityChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BgOpacityLabel" Grid.Row="2" Grid.Column="4" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </GroupBox>
                    <TextBlock Text="色は #RRGGBB 形式で入力（例: #F0F0F0）" Foreground="Gray" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="コピー項目">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="追加" Padding="12,4" Margin="0,0,0,6" Click="OnAddItem"/>
                        <Button Content="削除" Padding="12,4" Margin="0,0,0,6" Click="OnDeleteItem"/>
                        <Button Content="上へ" Padding="12,4" Margin="0,0,0,6" Click="OnMoveUp"/>
                        <Button Content="下へ" Padding="12,4" Click="OnMoveDown"/>
                    </StackPanel>
                    <ListBox x:Name="ItemsListBox" SelectionChanged="OnItemSelected"/>
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="編集（{ } 内が日時フォーマットとして展開されます）"/>
                    <TextBox x:Name="EditBox" Margin="0,2" TextChanged="OnEditChanged"/>
                    <TextBlock x:Name="PreviewText" Foreground="Gray"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="フォーマット早見表（クリックで編集欄に挿入）" Margin="0,10,0,2"/>
                <ListView Grid.Row="3" x:Name="FormatList" PreviewMouseLeftButtonUp="OnFormatListClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="書式" Width="150" DisplayMemberBinding="{Binding Format}"/>
                            <GridViewColumn Header="出力例" Width="280" DisplayMemberBinding="{Binding Example}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
